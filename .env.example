# ============================================================================
# Data Pipeline — environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.
# ============================================================================

# --- Database (required) ----------------------------------------------------
# PostgreSQL connection string. Production: Supabase pooled connection string.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- Encryption (required) --------------------------------------------------
# AES-256-GCM key for OAuth token encryption. 64 hex chars = 32 bytes.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Secret salt for HMAC customer-email hashing (falls back to ENCRYPTION_KEY).
EMAIL_HASH_SECRET=

# JWT access-token signing secret (falls back to ENCRYPTION_KEY).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Redis / Upstash (required for queues in production) --------------------
# HTTP-based Redis (Upstash). Queues are disabled gracefully without it.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Platform connectors ----------------------------------------------------
# USE_REAL_API=false (default) → deterministic mocks, full pipeline testable
# without any platform credentials. true → real API calls.
USE_REAL_API=false

# Shopify app (https://partners.shopify.com) — see README for setup
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_WEBHOOK_SECRET=

# Meta app (https://developers.facebook.com) — see README for setup
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# --- Background jobs --------------------------------------------------------
# Bearer secret Vercel Cron sends to /api/cron/* endpoints.
CRON_SECRET=

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Billing (optional; demo mode without these) ----------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# ---------------------------------------------------------------------------
# Clawjin Prism — environment variables
# Copy this file to `.env` and fill in your values.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Local development defaults to a local Postgres instance.
# In production (Neon / Supabase / Vercel), set this to your hosted database URL
# — use the *Pooled* connection string from Neon.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Public site URL — used for SEO (sitemap, robots.txt, OpenGraph).
# Set this to your deployed URL (e.g. https://your-app.vercel.app).
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
